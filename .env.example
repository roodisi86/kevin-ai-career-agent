# Copy to .env.local for local development. Never commit real values.
# On Netlify, set these under Site configuration → Environment variables.

# --- Required: Supabase (public values, safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Optional: Claude API (server-side only). Without it, AI suggestions are disabled. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Max AI requests per workspace per day (cost control)
AI_DAILY_REQUEST_CAP=50
# Max AI job assessments per day (one request per vacancy).
AI_DAILY_MATCH_CAP=150

# --- Optional: Adzuna job search API (free developer key, developer.adzuna.com) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Tests only ---
# Disposable Postgres server for the RLS test suite (npm run test:db)
DATABASE_TEST_URL=postgres://postgres@localhost:5432/postgres
# Synthetic DEMO account for Playwright (keep in .env.e2e.local, never commit)
# E2E_EMAIL=e2e-demo@example.invalid
# E2E_PASSWORD=
